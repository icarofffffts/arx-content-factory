    {
      "parameters": {
        "jsCode": "const text = $('Code - Extrair Texto').first().json.text.trim();\n\n// Tenta extrair DD/MM HH:mm do texto\nconst match = text.match(/(\\d{1,2})\\/(\\d{1,2})\\s+(\\d{1,2}):(\\d{2})/);\nif (!match) {\n  return [{ json: { parsed: false, error: 'Formato invalido. Use DD/MM HH:mm' } }];\n}\n\nconst day = parseInt(match[1]);\nconst month = parseInt(match[2]);\nconst hour = parseInt(match[3]);\nconst min = parseInt(match[4]);\nconst now = new Date();\nlet year = now.getFullYear();\n\n// Se mes for menor que mes atual, provavelmente e ano que vem\nif (month < now.getMonth() + 1 || (month === now.getMonth() + 1 && day < now.getDate())) {\n  year++;\n}\n\n// CORRECAO: Input do admin eh BRT (UTC-3), server roda UTC\n// Construir ISO explicitamente como BRT -03:00, depois converter pra UTC\nconst pad = n => String(n).padStart(2, '0');\nconst brtIso = `${year}-${pad(month)}-${pad(day)}T${pad(hour)}:${pad(min)}:00-03:00`;\nconst scheduled = new Date(brtIso);\nconst isoStr = scheduled.toISOString();\n\n// Formatar pra exibir\nconst display = scheduled.toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nreturn [{\n  json: {\n    parsed: true,\n    scheduled_at: isoStr,\n    display: display,\n    post_id: $('PG - Buscar Post em Rescheduling').first().json.id\n  }\n}];"
      },
