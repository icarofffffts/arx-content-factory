    {
      "parameters": {
        "jsCode": "// Extrai texto de mensagem comum (nao botao)\nconst input = $input.first().json;\nconst body = input.body || input;\nlet text = '';\nlet fromNumber = '';\n\nif (body && body.data) {\n  if (body.data.text) {\n    text = body.data.text;\n  } else if (body.data.Message && typeof body.data.Message.conversation === 'string') {\n    text = body.data.Message.conversation || '';\n  } else if (body.data.Message && body.data.Message.conversationMessage) {\n    text = body.data.Message.conversationMessage.text || '';\n  } else if (body.data.message && body.data.message.conversation) {\n    text = body.data.message.conversation || '';\n  } else if (body.data.Message && body.data.Message.extendedTextMessage) {\n    text = body.data.Message.extendedTextMessage.text || '';\n  }\n  if (body.data.key && body.data.key.remoteJid) {\n    fromNumber = body.data.key.remoteJid.split('@')[0];\n  }\n}\n\nreturn [{ json: { text: text, from_number: fromNumber, has_text: !!text } }];"
      },
