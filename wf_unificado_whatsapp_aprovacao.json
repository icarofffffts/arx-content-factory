      "parameters": {
        "jsCode": "const d = $input.first().json;\nif (!d || !d.id) {\n  return [{ json: { found: false, error: 'Draft nao encontrado' } }];\n}\n\nconst pdfUrl = d.pdf_url || '';\n\nlet slides = d.slides_data || [];\nif (typeof slides === 'string') {\n  try { slides = JSON.parse(slides); } catch(e) { slides = []; }\n}\nlet slidePreview = '';\nif (Array.isArray(slides)) {\n  slidePreview = slides.slice(0, 3).map(s => {\n    let t = s.title || s.content || '';\n    return t.length > 80 ? t.substring(0, 80) + '...' : t;\n  }).join('\\n');\n}\n\nreturn [{\n  json: {\n    id: d.id,\n    topic: d.topic || 'Sem titulo',\n    caption: d.linkedin_caption || '',\n    pdf_url: pdfUrl,\n    slide_preview: slidePreview,\n    found: true\n  }\n}];"
      },
