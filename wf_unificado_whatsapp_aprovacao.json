    {
      "parameters": {
        "jsCode": "// Evolution Go ButtonClick webhook\nconst input = $input.first().json;\nconst body = input.body || input;\nlet buttonId = '';\nlet buttonText = '';\n\nif (body && body.data) {\n  if (body.data.buttonId) {\n    buttonId = body.data.buttonId;\n  } else if (body.data.Message && body.data.Message.buttonsResponseMessage && body.data.Message.buttonsResponseMessage.selectedButtonID) {\n    buttonId = body.data.Message.buttonsResponseMessage.selectedButtonID;\n  }\n\n  if (body.data.buttonText) {\n    buttonText = body.data.buttonText;\n  } else if (body.data.Message && body.data.Message.buttonsResponseMessage && body.data.Message.buttonsResponseMessage.Response) {\n    buttonText = body.data.Message.buttonsResponseMessage.Response.SelectedDisplayText || '';\n  }\n}\n\nlet action = '';\nlet postId = '';\n\nif (buttonId.includes('approve_')) {\n  action = 'approve';\n  const rawId = buttonId.split('approve_')[1] || '';\n  const match = rawId.match(/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/);\n  if (match) postId = match[0];\n} else if (buttonId.includes('reject_')) {\n  action = 'reject';\n  const rawId = buttonId.split('reject_')[1] || '';\n  const match = rawId.match(/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/);\n  if (match) postId = match[0];\n} else if (buttonId.includes('reschedule_')) {\n  action = 'reschedule';\n  const rawId = buttonId.split('reschedule_')[1] || '';\n  const match = rawId.match(/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/);\n  if (match) postId = match[0];\n} else {\n  if (buttonId.includes('approve') || buttonText.includes('Aprovar')) {\n    action = 'approve';\n  } else if (buttonId.includes('reject') || buttonText.includes('Rejeitar')) {\n    action = 'reject';\n  } else if (buttonText.includes('Alterar') || buttonText.includes('Horario')) {\n    action = 'reschedule';\n  }\n}\nreturn [{\n  json: {\n    button_id: buttonId,\n    button_text: buttonText,\n    action: action,\n    post_id: postId,\n    parsed: !!action\n  }\n}];"
      },
