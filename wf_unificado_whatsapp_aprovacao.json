    {
      "parameters": {
        "jsCode": "const parseData = $('Code - Parsear Click do Botao').first().json;\nconst action = parseData.action;\nconst postId = $json.id || parseData.post_id;\nconst currentStatus = $json.status || '';\n\nif (!$json.id) {\n  return [{ json: { action: 'none', post_id: '', status: 'none', error: 'Nenhum post pendente' } }];\n}\n\n// Anti-duplicacao: bloqueia approve/reject duplicado, permite reschedule\nif (action !== 'reschedule' && currentStatus !== 'awaiting_approval') {\n  return [{ json: { action: 'none', post_id: postId, status: currentStatus, error: 'Post ja processado' } }];\n}\n\nif (action === 'approve') {\n  return [{ json: { action: 'approve', post_id: postId, status: 'scheduled' } }];\n} else if (action === 'reject') {\n  return [{ json: { action: 'reject', post_id: postId, status: 'deleted' } }];\n} else if (action === 'reschedule') {\n  return [{ json: { action: 'reschedule', post_id: postId, status: 'rescheduling' } }];\n} else {\n  return [{ json: { action: 'none', post_id: postId, status: 'none' } }];\n}"
      },
