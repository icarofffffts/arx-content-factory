{
  "name": "WhatsApp - Notificacao Automatica com Aprovacao",
  "nodes": [
    {
      "parameters": {
        "path": "notify-draft",
        "options": {}
      },
      "name": "Webhook - Receber ID do Draft",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [-720, -320],
      "webhookId": "notify-draft"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, topic, slides_data, media_paths, instagram_media_paths, pdf_url, linkedin_caption FROM public.content_pipeline WHERE id = '{{ $json.body.post_id }}';",
        "options": {}
      },
      "name": "PG - Buscar Detalhes do Draft",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [-560, -320],
      "credentials": {
        "postgres": {
          "id": "owASX235VSmdGPHh",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nif (!d || !d.id) {\n  return [{ json: { error: 'Draft nao encontrado', found: false } }];\n}\n\nlet mediaPaths = d.media_paths || d.instagram_media_paths || [];\nif (typeof mediaPaths === 'string') {\n  try { mediaPaths = JSON.parse(mediaPaths); } catch(e) { mediaPaths = []; }\n}\nconst imgUrl = Array.isArray(mediaPaths) && mediaPaths.length > 0 ? mediaPaths[0] : '';\n\nlet slides = d.slides_data || [];\nif (typeof slides === 'string') {\n  try { slides = JSON.parse(slides); } catch(e) { slides = []; }\n}\nlet slidePreview = '';\nif (Array.isArray(slides)) {\n  slidePreview = slides.slice(0, 3).map(s => { let t = s.title || s.content || ''; return t.length > 80 ? t.substring(0, 80) + '...' : t; }).join('\\n');\n}\n\nreturn [{\n  json: {\n    id: d.id,\n    topic: d.topic || 'Sem titulo',\n    caption: d.linkedin_caption || '',\n    image_url: imgUrl,\n    slide_preview: slidePreview,\n    found: true\n  }\n}];"
      },
      "name": "Code - Preparar Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, -320]
    },
    {
      "parameters": {
        "dataType": "boolean",
        "conditions": [
          {
            "id": "found-check",
            "leftValue": "={{ $json.found }}",
            "type": "boolean",
            "rightValue": true
          }
        ],
        "combineOperation": "all",
        "options": {}
      },
      "name": "IF - Draft Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [-240, -320]
    },
    {
      "parameters": {
        "resource": "sendMessage",
        "operation": "sendMedia",
        "instanceApiKey": "26cbfa77-76c5-489c-9c98-bd2ce4ed6e8d",
        "sendMediaNumber": "5531995398002",
        "sendMediaUrl": "={{ $json.image_url }}",
        "sendMediaCaption": "={{ $json.topic.substring(0, 100) }}",
        "sendMediaDelay": 1000,
        "sendMediaAdditionalFields": {},
        "requestOptions": {}
      },
      "name": "Enviar Imagem do Draft",
      "type": "n8n-nodes-evolution-go.evoGo",
      "typeVersion": 1,
      "position": [-80, -400],
      "credentials": {
        "evoGoApi": {
          "id": "pJuORISTpF0VjreA",
          "name": "EvoGo account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "resource": "sendMessage",
        "instanceApiKey": "26cbfa77-76c5-489c-9c98-bd2ce4ed6e8d",
        "sendTextNumber": "5531995398002",
        "sendTextContent": "=📋 *NOVO CONTEUDO PARA REVISAO!*\n\n*Topico:* {{ $json.topic }}\n\n{{ $json.slide_preview }}\n\nDeseja publicar este conteudo agora?",
        "sendTextDelay": 1500,
        "sendTextAdditionalFields": {},
        "requestOptions": {}
      },
      "name": "Enviar Texto Preview",
      "type": "n8n-nodes-evolution-go.evoGo",
      "typeVersion": 1,
      "position": [80, -240],
      "credentials": {
