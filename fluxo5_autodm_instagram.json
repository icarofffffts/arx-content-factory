        "jsCode": "const input = $input.first().json;\n\nconst body = input.body || input;\nconst entry = (body.entry && body.entry[0]) || {};\nconst changes = (entry.changes && entry.changes[0]) || {};\nconst value = changes.value || body;\n\nconst commentText = (value.text || value.comment_text || value.message || 'IA').toLowerCase();\nconst username = value.from?.username || value.username || 'usuario_teste';\nconst userId = value.from?.id || value.user_id || value.sender_id || '12345678';\nconst commentId = value.comment_id || value.id || 'comment_123';\nconst instagramPostId = value.media?.id || value.post_id || value.media_id || '';\n\nconst keywords = ['ia', 'links', 'vagas', 'pdf', 'curso', 'material', 'github'];\nconst hasKeyword = keywords.some(kw => commentText.includes(kw));\n\nreturn [{\n  json: {\n    user_id: userId,\n    username: username,\n    comment_id: commentId,\n    instagram_post_id: instagramPostId,\n    comment_text: commentText,\n    is_valid_lead: hasKeyword\n  }\n}];\n"
      },
