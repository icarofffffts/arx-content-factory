      "id": "664e93e5-54f5-4d47-8da5-7665c09ceca0",
      "name": "Existe post agendado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3232, -496]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst shortId = (item.id || 'post').split('-')[0];\nconst cleanName = item.topic\n  .toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9]/g, '-')\n  .replace(/-+/g, '-')\n  .replace(/^-|-$/g, '');\n\nconst repoName = `ai-${cleanName.substring(0, 25)}-${shortId}`.replace(/^-|-$/g, '');\nconst readmeText = `# ${item.topic}\n\n${item.linkedin_caption}\n\n---\n\n### 📄 Download do Carrossel em PDF\n👉 [Baixar Carrossel PDF completo](${item.pdf_url})\n\n---\n*Gerado automaticamente pela Content Factory de IA de @__icarofernandes*`;\nconst b64Content = Buffer.from(readmeText).toString('base64');\n\nreturn [{\n  json: {\n    repo_name: repoName,\n    topic: item.topic,\n    caption: item.linkedin_caption,\n    pdf_url: item.pdf_url,\n    post_id: item.id,\n    readme_content: readmeText,\n    b64_content: b64Content\n  }\n}];\n"
      },
      "id": "80f42222-9586-47d6-b799-924c41acd004",
      "name": "Formatar Markdown & Nome do Repo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3472, -496]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/user/repos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.repo_name }}\",\n  \"description\": \"Conteúdo sobre {{ $json.topic }} por Ícaro Fernandes\",\n  \"private\": false,\n  \"auto_init\": false\n}",
        "options": {}
      },
      "id": "3539af29-473b-441f-a5a6-a2015460057d",
      "name": "GitHub - Criar Repositório do Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3712, -496],
      "credentials": {
        "githubApi": {
          "id": "lk44WnEAXPNHeiCV",
          "name": "GitHub account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/{{ $json.owner?.login || 'icarofernandes' }}/{{ $('Formatar Markdown & Nome do Repo').first().json.repo_name }}/contents/README.md",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"docs: adicionar material do post\",\n  \"content\": \"{{ $('Formatar Markdown & Nome do Repo').first().json.b64_content }}\"\n}",
        "options": {}
      },
